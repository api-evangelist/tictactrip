            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v2/autocomplete",
            "params": [
              {
                "name": "q",
                "value": "Paris",
                "type": "query",
                "description": "The search query (e.g. a city name or prefix)"
