          "name": "Get Autocomplete",
          "request": {
            "name": "Get Autocomplete",
            "description": {
              "content": "Autocomplete search for stop clusters and stop groups by name.\nReturns cities and stations matching the query, filtered by the partner's allowed gpuids when applicable.\nMirrors the behaviour of the legacy GET /autocomplete route.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "autocomplete"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) The search query (e.g. a city name or prefix)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
